<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>{{metadata.reportTitle}} - {{metadata.reportId}}</title>
  <style>
    {{{cssContent}}}
  </style>
</head>
<body>

  {{#if metadata.options.includeCoverPage}}
  <!-- COVER PAGE -->
  <section class="page cover">
    <div class="cover-bg" style="background-image: url('{{#if coverImageUri}}{{coverImageUri}}{{else}}{{coverBgFlatUri}}{{/if}}');"></div>
    <div class="cover-overlay"></div>
    <div class="cover-inner">
      <div class="cover-top">
        <div class="brand">HWD TRADE</div>
        {{#if logoUri}}
        <img class="cover-logo" src="{{logoUri}}" alt="Logo" />
        {{/if}}
      </div>
      <div class="cover-mid">
        <span class="pill">{{#if metadata.siteChecksCompleted}}{{metadata.siteChecksCompleted}}{{else}}SITE CHECK 1 REPORT{{/if}}</span>
        <h1 class="cover-name">{{metadata.reportTitle}}</h1>
        <div class="cover-sub">{{metadata.reportType}}</div>
      </div>
      <div class="cover-card">
        <div class="cc"><div class="cc-l">PROPERTY ADDRESS</div><div class="cc-v">{{#if metadata.property.fullAddress}}{{metadata.property.fullAddress}}{{else}}N/A{{/if}}</div></div>
        <div class="cc"><div class="cc-l">BUILDER</div><div class="cc-v">{{#if metadata.builder}}{{metadata.builder}}{{else}}N/A{{/if}}</div></div>
        <div class="cc"><div class="cc-l">CHECK DATE</div><div class="cc-v">{{formattedDate}}</div></div>
        <div class="cc"><div class="cc-l">SITE CHECK REFERENCE</div><div class="cc-v">{{#if metadata.siteChecksCompleted}}{{metadata.siteChecksCompleted}}{{else}}HSC1 - Check 1{{/if}}</div></div>
        <div class="cc"><div class="cc-l">REPORT ID</div><div class="cc-v">{{metadata.reportId}}</div></div>
        <div class="cc"><div class="cc-l">INSPECTOR</div><div class="cc-v">{{#if metadata.inspector.name}}{{metadata.inspector.name}}{{else}}Site Inspector{{/if}}</div></div>
      </div>
      <div class="cover-foot">
        <div>CONFIDENTIAL REPORT &bull; PREPARED FOR BUILDER / CLIENT</div>
        <div class="status-red">STATUS: {{stats.overallStatus}}</div>
      </div>
    </div>
  </section>
  {{/if}}

  <!-- EXECUTIVE SUMMARY & DASHBOARD PAGE -->
  <section class="page">
    <div class="pg-head">
      <div class="ph-left">
        {{#if logoUri}}<img class="ph-logo" src="{{logoUri}}" alt="Logo">{{/if}}
        <span class="ph-title">INSPECTION SUMMARY</span>
      </div>
      <div class="ph-ref">REF: {{metadata.reportId}}</div>
    </div>

    <div class="pg-body">
      <div class="h2"><span class="h2-bar"></span>INSPECTION SUMMARY &amp; DASHBOARD</div>
      <p class="intro">{{introductionText}}</p>
      
      <div class="tiles">
        <div class="tile">
          <div class="tile-n">{{stats.totalChecks}}</div>
          <div class="tile-l">TOTAL CHECKS</div>
        </div>
        <div class="tile">
          <div class="tile-n">{{stats.completedCount}}</div>
          <div class="tile-l">COMPLETED</div>
        </div>
        <div class="tile {{#if stats.attentionCount}}attn{{/if}}">
          <div class="tile-n">{{stats.attentionCount}}</div>
          <div class="tile-l">NEEDS ATTENTION</div>
        </div>
        <div class="tile {{#if stats.cannotInstallCount}}crit{{/if}}">
          <div class="tile-n">{{stats.cannotInstallCount}}</div>
          <div class="tile-l">CANNOT INSTALL</div>
        </div>
      </div>

      <div class="outcome">
        <div class="oc-left">
          <div class="oc-l">OVERALL INSPECTION OUTCOME</div>
          <div class="oc-v">{{stats.overallStatus}}</div>
        </div>
        <div class="oc-right">{{stats.recommendedAction}}</div>
      </div>

      {{#if metadata.options.includeOutstandingItems}}
      {{#if outstandingItems.length}}
      <div class="h2"><span class="h2-bar"></span>OUTSTANDING ITEMS SUMMARY ({{outstandingItems.length}})</div>
      {{#each outstandingItems}}
      <div class="oi">
        <div class="oi-head">
          <span class="oi-num">ITEM {{this.itemNumber}}</span>
          <span class="oi-cat">{{this.sectionTitle}}</span>
        </div>
        <div class="oi-title">{{this.questionLabel}}</div>
        <div class="oi-flag {{#if this.isCrit}}crit{{/if}}">
          <span class="ic">{{this.status.icon}}</span>{{this.status.displayLabel}}
        </div>
        <div class="oi-action">REQUIRED ACTION: {{this.requiredAction}}</div>
      </div>
      {{/each}}
      {{/if}}
      {{/if}}
    </div>

    <div class="pg-foot">
      <div>{{#if metadata.property.fullAddress}}{{metadata.property.fullAddress}}{{else}}HWD Trade Site Inspection Report{{/if}}</div>
      <div>Report ID: {{metadata.reportId}}</div>
    </div>
  </section>

  <!-- INSPECTION DETAILS SECTIONS -->
  <section class="page">
    <div class="pg-head">
      <div class="ph-left">
        {{#if logoUri}}<img class="ph-logo" src="{{logoUri}}" alt="Logo">{{/if}}
        <span class="ph-title">INSPECTION DETAILS</span>
      </div>
      <div class="ph-ref">REF: {{metadata.reportId}}</div>
    </div>

    <div class="pg-body">
      {{#each sections}}
      <div class="section">
        <div class="sec-head">{{this.title}}</div>
        <div class="sec-body">
          {{#each this.questions}}
          {{#if this.isNote}}
          <div class="noterow">
            <div class="notelabel">{{this.label}}</div>
            <div class="notebox">{{#if this.rawResponse}}{{this.rawResponse}}{{else}}None recorded.{{/if}}</div>
          </div>
          {{else}}
          <div class="row">
            <div class="q">{{this.label}}</div>
            <div class="a">
              <span class="{{this.status.badgeClass}}">
                {{#if this.status.icon}}<span class="ic">{{this.status.icon}}</span>{{/if}}
                {{this.status.displayLabel}}
              </span>
            </div>
          </div>
          {{/if}}
          {{/each}}
        </div>
      </div>
      {{/each}}

      {{#if generalNotesList.length}}
      <div class="section">
        <div class="sec-head">GENERAL INSPECTION NOTES &amp; COMMENTS</div>
        <div class="sec-body">
          <ul class="genlist">
            {{#each generalNotesList}}
            <li>{{this}}</li>
            {{/each}}
          </ul>
        </div>
      </div>
      {{/if}}
    </div>

    <div class="pg-foot">
      <div>{{#if metadata.property.fullAddress}}{{metadata.property.fullAddress}}{{else}}HWD Trade Site Inspection Report{{/if}}</div>
      <div>Report ID: {{metadata.reportId}}</div>
    </div>
  </section>

  {{#if metadata.options.includePhotographs}}
  {{#if galleryPages.length}}
  <!-- PHOTOGRAPHIC EVIDENCE DIVIDER -->
  <section class="page">
    <div class="pg-head">
      <div class="ph-left">
        {{#if logoUri}}<img class="ph-logo" src="{{logoUri}}" alt="Logo">{{/if}}
        <span class="ph-title">PHOTOGRAPHIC EVIDENCE</span>
      </div>
      <div class="ph-ref">REF: {{metadata.reportId}}</div>
    </div>

    <div class="pg-body">
      <div class="photo-cover">
        <div class="pc-inner">
          <h2 class="pc-title">SITE PHOTOGRAPHY</h2>
          <div class="pc-sub">Inspection Photographic Evidence &amp; Detailed Observations</div>
          <div class="pc-count">Total Photos Attached: {{stats.totalPhotos}}</div>
        </div>
      </div>
    </div>

    <div class="pg-foot">
      <div>{{#if metadata.property.fullAddress}}{{metadata.property.fullAddress}}{{else}}HWD Trade Site Inspection Report{{/if}}</div>
      <div>Report ID: {{metadata.reportId}}</div>
    </div>
  </section>

  <!-- GALLERY PAGES -->
  {{#each galleryPages}}
  <section class="page">
    <div class="pg-head">
      <div class="ph-left">
        {{#if ../logoUri}}<img class="ph-logo" src="{{../logoUri}}" alt="Logo">{{/if}}
        <span class="ph-title">PHOTOGRAPHIC EVIDENCE</span>
      </div>
      <div class="ph-ref">PAGE {{this.pageNumber}} OF {{../galleryPages.length}}</div>
    </div>

    <div class="pg-body">
      {{#each this.photos}}
      <div class="photo-card">
        <img src="{{this.base64DataUri}}" alt="Photo {{this.sequence}}" />
        <div class="photo-label">PHOTO {{#if this.sequence}}{{this.sequence}}{{else}}--{{/if}}</div>
      </div>
      {{/each}}
    </div>

    <div class="pg-foot">
      <div>{{#if ../metadata.property.fullAddress}}{{../metadata.property.fullAddress}}{{else}}HWD Trade Site Inspection Report{{/if}}</div>
      <div>Report ID: {{../metadata.reportId}}</div>
    </div>
  </section>
  {{/each}}
  {{/if}}
  {{/if}}

</body>
</html>
